+    assert not report["requires_environment_context"]
+    dataset = DissipativeWindowDataset(stripped, "train", history=cfg["history"], max_horizon=2)
+    try:
+        assert set(dataset.batch([0, 1])) == set(MODEL_FIELDS) == {"pixels", "action", "dt_frame"}
+    finally:
+        dataset.close()
+
