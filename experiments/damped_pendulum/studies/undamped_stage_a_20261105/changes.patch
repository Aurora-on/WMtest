+                   potential=parameters(model.core.potential_net), damping=damping,
+                   environment=parameters(model.environment_encoder),
+                   input_port=parameters(model.core.input_net))
+    all_ids = [id(parameter) for values in modules.values() for parameter in values]
+    if len(all_ids) != len(set(all_ids)) or set(all_ids) != {id(p) for p in model.parameters()}:
+        raise ValueError("Named training modules must partition all model parameters exactly once")
+    if selected is not None and any(not modules[name] for name in selected):
+        raise ValueError("Selected trainable module has no parameters")
