+def render_smooth_float(theta, size=64):
+    """Continuous subpixel RGB in [0, 1], before uint8 quantization.
+
+    Analytic signed distances to a round-ended rod and two circles determine
+    smoothstep edge coverage over a one-pixel band. This is antialiasing, not
+    exact pixel-area integration. No geometry is rounded to pixel indices.
+    Coverage and compositing are continuous in theta; the stored uint8 image
+    still has one-level quantization boundaries and cannot be globally
+    continuous. Keep this float path for continuity/derivative diagnostics.
+    """
+    if not np.isscalar(theta) or not np.isfinite(theta):
+        raise ValueError("theta must be a finite scalar")
+    if isinstance(size, (bool, np.bool_)) or not isinstance(size, (int, np.integer)) or size < 1:
+        raise ValueError("size must be a positive integer")
+    yy, xx = np.mgrid[:size, :size].astype(np.float64) + 0.5
+    pivot, length = size / 2., size * .36
+    dx, dy = length * np.sin(theta), length * np.cos(theta)
+    rx, ry = xx - pivot, yy - pivot
+    projection = np.clip((rx * dx + ry * dy) / length**2, 0., 1.)
+    rod_distance = np.hypot(rx - projection * dx, ry - projection * dy) - 1.
+    bob_distance = np.hypot(rx - dx, ry - dy) - 3.
+    pivot_distance = np.hypot(rx, ry) - 2.
+    rgb = np.ones((size, size, 3), dtype=np.float64)
+    for distance, color in ((rod_distance, (50, 50, 50)),
+                            (bob_distance, (200, 40, 40)),
+                            (pivot_distance, (50, 50, 50))):
+        edge = np.clip(.5 - distance, 0., 1.)
+        alpha = (edge * edge * (3. - 2. * edge))[..., None]
+        rgb = rgb * (1. - alpha) + np.asarray(color, dtype=np.float64) / 255. * alpha
+    return rgb
